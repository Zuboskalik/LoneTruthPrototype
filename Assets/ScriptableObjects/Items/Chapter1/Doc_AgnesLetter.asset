  id: doc_agnes_letter
  itemName: "\u041F\u0438\u0441\u044C\u043C\u043E \u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
  icon: {fileID: 21300000, guid: b12e73de996b5b24f8a1b52ec0d2ba78, type: 3}
  itemType: 4
  maxStack: 1
  description: "\u041F\u0438\u0441\u044C\u043C\u043E, \u0438\u0437-\u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0425\u043E\u043B\u0442 \u043F\u0440\u0438\u0435\u0445\u0430\u043B. G \u2014 \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u0442\u044C."
  documentText: "\xAB\u041C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442.\n\n\u0422\u043E\u043C\u0430\u0441 \u0436\u0438\u0432. \u041E\u043D \u043F\u0438\u0448\u0435\u0442 \u043C\u043D\u0435 \u043F\u043E \u043D\u043E\u0447\u0430\u043C.\n\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C \u043F\u0438\u0441\u044C\u043C\u0435 \u043E\u043D \u043D\u0430\u0437\u0432\u0430\u043B \u0432\u0430\u0448\u0435 \u0438\u043C\u044F.\xBB\n\n\u2014 \u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D, \u0425\u043E\u043B\u043B\u043E\u0443-\u0420\u043E\u043A"
  healAmount: 0
