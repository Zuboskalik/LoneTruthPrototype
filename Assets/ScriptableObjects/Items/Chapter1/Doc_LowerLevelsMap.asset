  id: doc_lower_levels_map
  itemName: "\u041A\u0430\u0440\u0442\u0430 \u043D\u0438\u0436\u043D\u0438\u0445 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u0432"
  icon: {fileID: 21300000, guid: 6f104f9a81c1d264da287480de9e389f, type: 3}
  itemType: 4
  maxStack: 1
  description: "\u041A\u0430\u0440\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B \u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B. G \u2014 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C."
  documentText: "\u041A\u0430\u0440\u0442\u0430 \u043D\u0438\u0436\u043D\u0438\u0445 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u0432 \u0448\u0430\u0445\u0442\u044B \xAB\u0421\u0432\u044F\u0442\u0430\u044F \u0412\u0430\u0440\u0432\u0430\u0440\u0430\xBB, \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0440\u0443\u043A\u043E\u0439 \u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B\u0430.\n\n\u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u044B 1\u20133, \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0435 \u0445\u043E\u0434\u044B, \u0441\u0442\u0430\u0440\u044B\u0435 \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0438. \u041E\u0434\u0438\u043D \u043F\u0440\u043E\u0445\u043E\u0434 \u043E\u0442\u043C\u0435\u0447\u0435\u043D \u043A\u0440\u0435\u0441\u0442\u043E\u043C."
  healAmount: 0
