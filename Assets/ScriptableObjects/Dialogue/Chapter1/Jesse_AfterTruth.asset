  nodes:
  - id: ask
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u041A\u0430\u0440\u0442\u0443 \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B, \u043C\u0438\u0441\u0442\u0435\u0440. \u0427\u0435\u0433\u043E \u0435\u0449\u0451?"
    next: 
    setFlags: []
    choices:
    - text: "\u0414\u0430\u0442\u044C \u0431\u0438\u043D\u0442: \xAB\u0414\u0435\u0440\u0436\u0438. \u041F\u0435\u0440\u0435\u0432\u044F\u0436\u0438 \u0440\u0430\u043D\u0443, \u043F\u043E\u043A\u0430 \u043D\u0435 \u0437\u0430\u0433\u043D\u043E\u0438\u043B\u0430\u0441\u044C\xBB."
