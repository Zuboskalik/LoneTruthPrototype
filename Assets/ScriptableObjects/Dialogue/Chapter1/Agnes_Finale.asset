      next: 
  - id: hope
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u042F \u0437\u043D\u0430\u043B\u0430. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0435\u0433\u043E \u043B\u0430\u043C\u043F\u0443, \u043C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442. \u0412\u043D\u0438\u0437\u0443 \u043E\u043D\u0430 \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u0435\u0435."
    next: lamp
    setFlags: []
    choices: []
  - id: lamp
    speaker: 
    text: "\u041A\u0430\u0440\u0431\u0438\u0434\u043D\u0430\u044F \u043B\u0430\u043C\u043F\u0430 \u0422\u043E\u043C\u0430\u0441\u0430. \u0410\u0433\u043D\u0435\u0441 \u0434\u0435\u0440\u0436\u0430\u043B\u0430 \u0435\u0451 \u043D\u0430 \u0433\u0432\u043E\u0437\u0434\u0435 \u0443 \u0434\u0432\u0435\u0440\u0438 \u0446\u0435\u043B\u044B\u0439 \u043C\u0435\u0441\u044F\u0446."
    next: 
    setFlags: []
    choices: []
  - id: despair
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u041C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0438\u2026 \u0417\u043D\u0430\u0447\u0438\u0442, \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0438. \u0423\u0445\u043E\u0434\u0438\u0442\u0435, \u043C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442."
    next: despair_inner
    setFlags: []
    choices: []
  - id: despair_inner
    speaker: 
    text: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u043F\u043E\u0434 \u0434\u0432\u0435\u0440\u044C \u043A\u043E\u043D\u0442\u043E\u0440\u044B, \u0441\u0442\u043E \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u0432 \u043E\u0442\u0432\u0435\u0442. \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u0437\u0430\u043B\u044C\u0451\u0442 \u0441\u043A\u0432\u0430\u0436\u0438\u043D\u0443 \u0431\u0435\u0442\u043E\u043D\u043E\u043C."
    next: 
    setFlags: []
    choices: []
  - id: truth
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\xAB\u0414\u0435\u0441\u044F\u0442\u0438\u043D\u0430\xBB\u2026 \xAB\u0421\u0442\u0430\u0440\u0438\u043A, \u0447\u0442\u043E \u043D\u0435 \u0441\u0442\u0430\u0440\u0435\u0435\u0442\xBB\u2026 \xAB\u0421\u044D\u043C\u044E\u044D\u043B \u0425\u043E\u043B\u0442, \u0441\u044B\u043D \u042D\u0434\u0433\u0430\u0440\u0430\xBB. \u0422\u043E\u043C\u0430\u0441 \u0442\u0430\u043A \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B. \u041D\u0438\u043A\u043E\u0433\u0434\u0430."
    next: truth_end
    setFlags: []
    choices: []
  - id: truth_end
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u041A\u0442\u043E \u0431\u044B \u043D\u0438 \u0432\u043E\u0434\u0438\u043B \u0435\u0433\u043E \u0440\u0443\u043A\u043E\u0439 \u2014 \u043E\u043D \u0442\u0430\u043C, \u0432\u043D\u0438\u0437\u0443. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0435\u0433\u043E \u043B\u0430\u043C\u043F\u0443."
    next: lamp
    setFlags: []
    choices: []
