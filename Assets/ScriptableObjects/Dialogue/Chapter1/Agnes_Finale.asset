  startNode: ask
  nodes:
  - id: ask
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u0412\u044B \u0431\u044B\u043B\u0438 \u0443 \u0441\u043A\u0432\u0430\u0436\u0438\u043D\u044B, \u043C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442? \u0427\u0442\u043E \u0442\u0430\u043C?"
    next: 
    setFlags: []
    choices:
    - text: "\u0422\u043E\u043C\u0430\u0441, \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u0436\u0438\u0432. \u0421\u043D\u0438\u0437\u0443 \u0441\u0442\u0443\u0447\u0430\u0442. \u042F \u0435\u0433\u043E \u0432\u0435\u0440\u043D\u0443."
      requiredFlags: []
      forbiddenFlags: []
      presentClue: 
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 0
      lockedHint: 
      questId: 1_1
      outcomeId: hope
      givesShard: 0
      shard: 0
      shards: 1
      setFlags:
      - clue_thomas_lamp
      clearFlags: []
      giveItem: {fileID: 0}
      giveAmount: 1
      takeItem: {fileID: 0}
      takeAmount: 1
      money: 0
      openShop: {fileID: 0}
      next: hope
    - text: "\u0422\u043E\u0442 \u0436\u0435 \u043F\u043E\u0447\u0435\u0440\u043A. \u041D\u043E \u0422\u043E\u043C\u0430\u0441 \u043D\u0435 \u0437\u043D\u0430\u043B \u044D\u0442\u0438\u0445 \u0441\u043B\u043E\u0432. \u0415\u0433\u043E \u0440\u0443\u043A\u043E\u0439 \u043A\u0442\u043E-\u0442\u043E \u0432\u043E\u0434\u0438\u0442."
      requiredFlags: []
      forbiddenFlags: []
      presentClue: clue_thomas_old_letter
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 1
      lockedHint: 
      questId: 1_1
      outcomeId: truth
      givesShard: 0
      shard: 0
      shards: 1
      setFlags:
      - clue_thomas_lamp
      clearFlags: []
      giveItem: {fileID: 0}
      giveAmount: 1
      takeItem: {fileID: 0}
      takeAmount: 1
      money: 0
      openShop: {fileID: 0}
      next: truth
    - text: "\u041F\u0438\u0441\u044C\u043C\u0430 \u2014 \u0436\u0435\u0441\u0442\u043E\u043A\u0430\u044F \u0448\u0443\u0442\u043A\u0430 \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0438. \u0417\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u043E \u043D\u0438\u0445."
      requiredFlags: []
      forbiddenFlags: []
      presentClue: 
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 0
      lockedHint: 
      questId: 1_1
      outcomeId: despair
      givesShard: 0
      shard: 0
      shards: 1
      setFlags:
      - VENT_SEALED
      clearFlags: []
      giveItem: {fileID: 0}
      giveAmount: 1
      takeItem: {fileID: 0}
      takeAmount: 1
      money: 100
      openShop: {fileID: 0}
      next: despair
    - text: "\u041F\u043E\u043A\u0430 \u043D\u0435 \u043C\u043E\u0433\u0443 \u0441\u043A\u0430\u0437\u0430\u0442\u044C. \u042F \u0435\u0449\u0451 \u0432\u0435\u0440\u043D\u0443\u0441\u044C."
      requiredFlags: []
      forbiddenFlags: []
      presentClue: 
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 0
      lockedHint: 
      questId: 
      outcomeId: 
      givesShard: 0
