  startNode: aim
  nodes:
  - id: aim
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u0421\u0442\u043E\u0439! \u0415\u0449\u0451 \u0448\u0430\u0433 \u2014 \u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044E."
    next: 
    setFlags: []
    choices:
    - text: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E. \u042F \u043D\u0435 \u043E\u0442 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438. \u041C\u0435\u043D\u044F \u043F\u043E\u0437\u0432\u0430\u043B\u0430 \u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D."
      requiredFlags: []
      forbiddenFlags: []
      presentClue: 
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 0
      lockedHint: 
      questId: 
      outcomeId: 
      givesShard: 0
      shard: 0
      shards: 1
      setFlags: []
      clearFlags: []
      giveItem: {fileID: 0}
      giveAmount: 1
      takeItem: {fileID: 0}
      takeAmount: 1
      money: 0
      openShop: {fileID: 0}
      next: agnes
    - text: "\u041B\u0430\u0434\u043D\u043E, \u043B\u0430\u0434\u043D\u043E. \u0423\u0445\u043E\u0436\u0443."
      requiredFlags: []
      forbiddenFlags: []
      presentClue: 
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 0
