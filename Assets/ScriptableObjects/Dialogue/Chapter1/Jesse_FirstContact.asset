      next: 
  - id: agnes
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u0410\u0433\u043D\u0435\u0441?.. \u0416\u0435\u043D\u0430 \u0422\u043E\u043C\u0430\u0441\u0430."
    next: name
    setFlags: []
    choices: []
  - id: name
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B. \u042F \u0432\u044B\u0431\u0440\u0430\u043B\u0441\u044F \u043E\u0442\u0442\u0443\u0434\u0430 \u0434\u043E \u043E\u0431\u0432\u0430\u043B\u0430. \u0410 \u043F\u043E\u0442\u043E\u043C \u043C\u0435\u043D\u044F \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u043E."
    next: deal
    setFlags: []
    choices: []
  - id: deal
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u0431\u0438\u043D\u0442 \u0438 \u0432\u0438\u0441\u043A\u0438. \u0412\u044B\u0432\u0435\u0437\u0438\u0442\u0435 \u043C\u0435\u043D\u044F \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430 \u0442\u0430\u0439\u043A\u043E\u043C \u2014 \u043E\u0442\u0434\u0430\u043C \u043A\u0430\u0440\u0442\u0443 \u043D\u0438\u0436\u043D\u0438\u0445 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u0432."
    next: wound
    setFlags:
    - q1_2_found_jesse
    choices: []
  - id: wound
    speaker: 
    text: "\u0420\u0430\u043D\u0430 \u0432 \u0431\u043E\u043A\u0443, \u043F\u043E\u0432\u044F\u0437\u043A\u0430 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C. \u0414\u043E\u043B\u0433\u043E \u043E\u043D \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u043F\u0440\u043E\u0442\u044F\u043D\u0435\u0442."
    next: 
    setFlags: []
    choices: []
