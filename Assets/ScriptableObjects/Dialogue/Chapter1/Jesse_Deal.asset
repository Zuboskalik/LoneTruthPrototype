  - id: wound
    speaker: 
    text: "\u041A\u0440\u0430\u044F \u0440\u043E\u0432\u043D\u044B\u0435, \u0432\u043D\u0443\u0442\u0440\u0438 \u0437\u0430\u0441\u0435\u043B \u043C\u0435\u0442\u0430\u043B\u043B. \u042D\u0442\u043E \u043D\u0435 \u043A\u0430\u043C\u0435\u043D\u044C \u2014 \u044D\u0442\u043E \u043F\u0443\u043B\u044F."
    next: ask
    setFlags:
    - jesse_wound_examined
    choices: []
  - id: hope
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u043C\u0438\u0441\u0442\u0435\u0440. \u041A\u0430\u0440\u0442\u0443 \u0437\u0430\u0432\u0442\u0440\u0430 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442 \u041B\u0438\u0430\u043C."
    next: 
    setFlags: []
    choices: []
  - id: despair
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u0414\u0435\u0440\u0436\u0438. \u2026\u0411\u0443\u0434\u044C \u0442\u044B \u043F\u0440\u043E\u043A\u043B\u044F\u0442, \u0441\u044B\u0449\u0438\u043A."
    next: despair_inner
    setFlags: []
    choices: []
  - id: despair_inner
    speaker: 
    text: "\u041A\u0430\u0440\u0442\u0430 \u0443 \u043C\u0435\u043D\u044F. \u0410 \u0414\u0436\u0435\u0441\u0441\u0438 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0437\u0434\u0435\u0441\u044C \u043E\u0434\u0438\u043D."
    next: 
    setFlags: []
    choices: []
  - id: truth
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u041F\u0443\u043B\u044F. \u0417\u0430 \u0447\u0430\u0441 \u0434\u043E \u043E\u0431\u0432\u0430\u043B\u0430 \u043B\u044E\u0434\u0438 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B\u0438 \u0437\u0430\u0440\u044F\u0434\u044B \u2014 \u0413\u0440\u0435\u0439\u0434\u0438 \u0441 \u043D\u0438\u043C\u0438. \u042F \u0432\u0438\u0434\u0435\u043B. \u0410 \u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D \u0441\u0442\u0440\u0435\u043B\u044F\u043B \u043C\u043D\u0435 \u0432\u0441\u043B\u0435\u0434."
    next: truth_end
    setFlags: []
    choices: []
  - id: truth_end
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u042F \u0432\u0441\u0451 \u043D\u0430\u043F\u0438\u0448\u0443, \u043C\u0438\u0441\u0442\u0435\u0440. \u0418 \u043A\u0430\u0440\u0442\u0443 \u043E\u0442\u0434\u0430\u043C."
