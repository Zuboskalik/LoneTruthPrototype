      requiredItem: {fileID: 11400000, guid: 75dadd6c651539b4aa99083c1947bb58, type: 2}
      requiredAmount: 1
      hideWhenLocked: 0
      lockedHint: "\u043D\u0443\u0436\u0435\u043D \u0431\u0438\u043D\u0442"
