      clearFlags: []
      giveItem: {fileID: 11400000, guid: facea24e2631e6b4298841bcaa044eab, type: 2}
      giveAmount: 1
      takeItem: {fileID: 0}
      takeAmount: 1
      money: 0
      openShop: {fileID: 0}
      next: despair
    - text: "\u0414\u0430\u0439 \u0432\u0437\u0433\u043B\u044F\u043D\u0443 \u043D\u0430 \u0440\u0430\u043D\u0443."
