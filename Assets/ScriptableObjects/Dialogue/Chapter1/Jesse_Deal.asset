  startNode: ask
  nodes:
  - id: ask
    speaker: "\u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B"
    text: "\u041D\u0443 \u0447\u0442\u043E, \u043C\u0438\u0441\u0442\u0435\u0440? \u0411\u0438\u043D\u0442 \u0438 \u0432\u0438\u0441\u043A\u0438?"
    next: 
    setFlags: []
    choices:
    - text: "\u0414\u0435\u0440\u0436\u0438 \u043C\u043E\u0439 \u0431\u0438\u043D\u0442. \u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E \u0441\u043F\u0440\u044F\u0447\u0435\u0442 \u0442\u0435\u0431\u044F \u0432 \u0440\u0438\u0437\u043D\u0438\u0446\u0435."
