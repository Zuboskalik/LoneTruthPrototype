      takeAmount: 1
      money: 0
      openShop: {fileID: 0}
      next: hope
    - text: "\u0414\u0430\u0432\u0430\u0439 \u043A\u0430\u0440\u0442\u0443. \u0414\u0430\u043B\u044C\u0448\u0435 \u0441\u0430\u043C."
