      setFlags:
      - clue_death_book
      - edgar_grave_known
      clearFlags: []
      giveItem: {fileID: 11400000, guid: f2ea57b6ae54fa340908c33e0ca6fe97, type: 2}
      giveAmount: 3
      takeItem: {fileID: 0}
      takeAmount: 1
      money: 0
      openShop: {fileID: 0}
      next: truth
    - text: "\u041A\u043D\u0438\u0433\u0430 \u0438 \u0432\u0430\u0448\u0438 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F \u2014 \u0438\u043B\u0438 \u043E\u0431 \u044D\u0442\u043E\u043C \u0443\u0437\u043D\u0430\u0435\u0442 \u0432\u0435\u0441\u044C \u0433\u043E\u0440\u043E\u0434."
      requiredFlags: []
      forbiddenFlags: []
      presentClue: 
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 0
      lockedHint: 
      questId: 1_3
      outcomeId: despair
      givesShard: 0
