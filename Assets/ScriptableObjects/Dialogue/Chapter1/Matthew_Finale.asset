  - id: hope
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u2026\u0414\u0430. \u0412\u043E\u0442 \u043A\u043D\u0438\u0433\u0430 \u0441\u043C\u0435\u0440\u0442\u0435\u0439. \u0418 \u0444\u0430\u043B\u044C\u0448\u0444\u0435\u0439\u0435\u0440\u044B, \u044F \u0438\u0445 \u043E\u0441\u0432\u044F\u0442\u0438\u043B \u2014 \u043E\u0433\u043E\u043D\u044C \u0431\u0435\u0440\u0451\u0442 \u041F\u0443\u0441\u0442\u044B\u0445. \u041A\u043E\u043B\u043E\u043A\u043E\u043B \u0431\u0443\u0434\u0435\u0442 \u0437\u0432\u043E\u043D\u0438\u0442\u044C."
    next: end_hope
    setFlags: []
    choices: []
  - id: end_hope
    speaker: 
    text: "\u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C, \u0441\u0435\u043C\u043D\u0430\u0434\u0446\u0430\u0442\u044C, \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0438. \u041D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0442\u0435\u043B\u0430."
    next: 
    setFlags: []
    choices: []
  - id: despair
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u0411\u0435\u0440\u0438\u0442\u0435. \u0412\u043E\u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432 \u0438 \u043A\u043D\u0438\u0433\u0430. \u042D\u0442\u043E\u0439 \u0436\u0435 \u043D\u043E\u0447\u044C\u044E \u043C\u0435\u043D\u044F \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
    next: end_despair
    setFlags: []
    choices: []
  - id: end_despair
    speaker: 
    text: "\u0412\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u0438\u043C \u0443\u0439\u0434\u0451\u0442 \u0438 \u0437\u0432\u043E\u043D\u0430\u0440\u044C. \u041A\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0442 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0438\u0445 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u043E\u043C?"
    next: 
    setFlags: []
    choices: []
  - id: truth
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u0421\u0442\u0440\u0430\u043D\u0438\u0446\u0430 \u0442\u044B\u0441\u044F\u0447\u0430 \u0434\u0435\u0432\u044F\u0442\u044C\u0441\u043E\u0442 \u0448\u0435\u0441\u0442\u043E\u0433\u043E. \u0421\u0435\u043C\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0438\u043C\u0451\u043D\u2026 \u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u0441\u0430\u043C\u0438."
    next: truth_name
    setFlags: []
    choices: []
  - id: truth_name
    speaker: 
    text: "\u042D\u0434\u0433\u0430\u0440 \u0425\u043E\u043B\u0442. \u041C\u043E\u0439 \u043E\u0442\u0435\u0446. \u0415\u0433\u043E \u0433\u0440\u043E\u0431 \u0442\u043E\u0436\u0435 \u043F\u0443\u0441\u0442\u043E\u0439?"
    next: truth_end
    setFlags: []
    choices: []
  - id: truth_end
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u041C\u043E\u0433\u0438\u043B\u0430 \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435, \u0441\u0440\u0435\u0434\u0438 \u0448\u0435\u0441\u0442\u043E\u0433\u043E \u0433\u043E\u0434\u0430. \u041B\u043E\u043F\u0430\u0442\u0430 \u0443 \u0441\u0442\u043E\u0440\u043E\u0436\u0430. \u0418 \u0432\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0444\u0430\u043B\u044C\u0448\u0444\u0435\u0439\u0435\u0440\u044B \u2014 \u044F \u0438\u0445 \u043E\u0441\u0432\u044F\u0442\u0438\u043B."
    next: 
    setFlags: []
    choices: []
