  startNode: note
  nodes:
  - id: note
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u042D\u0439\u043C\u043E\u0441 \u043F\u0435\u0440\u0435\u0434\u0430\u043B: \xAB\u0421\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442. \u0421\u043F\u0440\u043E\u0441\u0438 \u043F\u0440\u043E \u043A\u043D\u0438\u0433\u0443\xBB."
    next: confess
    setFlags: []
    choices: []
  - id: confess
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u0436\u0435\u0440\u0442\u0432\u0443\u0435\u0442 \u043D\u0430 \u0447\u0430\u0441\u043E\u0432\u043D\u044E. \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u044F \u0445\u043E\u0440\u043E\u043D\u044E \u043F\u0443\u0441\u0442\u044B\u0435 \u0433\u0440\u043E\u0431\u044B \u0438 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044E \u0438\u043C\u0435\u043D\u0430."
    next: ask
    setFlags: []
    choices: []
  - id: ask
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u0427\u0442\u043E \u0432\u044B \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u043E \u043C\u043D\u043E\u0439 \u0441\u0434\u0435\u043B\u0430\u0435\u0442\u0435, \u043C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442?"
    next: 
    setFlags: []
    choices:
    - text: "\u0425\u0432\u0430\u0442\u0438\u0442 \u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C \u043F\u0443\u0441\u0442\u044B\u0435 \u0433\u0440\u043E\u0431\u044B. \u041F\u043E\u043C\u043E\u0433\u0438\u0442\u0435 \u043B\u044E\u0434\u044F\u043C, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u043E."
      requiredFlags: []
      forbiddenFlags: []
      presentClue: 
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 0
      lockedHint: 
      questId: 1_3
      outcomeId: hope
      givesShard: 0
      shard: 0
      shards: 1
      setFlags:
      - clue_death_book
      clearFlags: []
      giveItem: {fileID: 11400000, guid: f2ea57b6ae54fa340908c33e0ca6fe97, type: 2}
      giveAmount: 3
      takeItem: {fileID: 0}
      takeAmount: 1
      money: 0
      openShop: {fileID: 0}
      next: hope
    - text: "\u042D\u0442\u043E\u0442 \u0436\u0435\u0442\u043E\u043D \u044F \u0441\u043D\u044F\u043B \u0441 \u043C\u0451\u0440\u0442\u0432\u043E\u0433\u043E \u0448\u0430\u0445\u0442\u0451\u0440\u0430. \u0427\u044C\u0438 \u0433\u0440\u043E\u0431\u044B \u043F\u0443\u0441\u0442\u044B\u0435?"
      requiredFlags: []
      forbiddenFlags: []
      presentClue: clue_token_1882
      requiredItem: {fileID: 0}
      requiredAmount: 1
      hideWhenLocked: 1
      lockedHint: 
      questId: 1_3
      outcomeId: truth
      givesShard: 0
      shard: 0
