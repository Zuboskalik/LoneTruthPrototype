  title: "\u0422\u0430\u0431\u043B\u0438\u0447\u043A\u0438 \u0441 \u0438\u043C\u0435\u043D\u0430\u043C\u0438 \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0445"
  place: "\u0427\u0430\u0441\u043E\u0432\u043D\u044F \u0421\u0432\u044F\u0442\u043E\u0439 \u0412\u0430\u0440\u0432\u0430\u0440\u044B"
  description: "\u0422\u0440\u0438 \u043E\u0431\u0432\u0430\u043B\u0430: 1882, 1906, 1936. \u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C, \u0441\u0435\u043C\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0438 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0438 \u0438\u043C\u0435\u043D\u0438. \u041A\u0440\u0430\u0441\u043A\u0430 \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0435 \u0435\u0449\u0451 \u0441\u0432\u0435\u0436\u0430\u044F."
