  id: ch1_signature
  title: "\u0426\u0435\u043D\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u0438"
  isMainQuest: 1
  failFlag: 
  stages:
  - flag: choice_signature
    text: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u043F\u043E\u043B\u043E\u0436\u0438\u043B \u043D\u0430 \u0441\u0442\u043E\u043B $500 \u0438 23 \u0431\u043B\u0430\u043D\u043A\u0430 \u0430\u043A\u0442\u043E\u0432 \u043E \u0441\u043C\u0435\u0440\u0442\u0438: \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u0442\u044C \u0438 \u0443\u0435\u0445\u0430\u0442\u044C \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0436\u0435."
  outcomes:
  - id: refuse
    shard: 0
    shards: 2
    requiredFlag: 
    text: "\u041E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F: \xAB\u041C\u0451\u0440\u0442\u0432\u044B\u0445 \u044F \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u044E, \u043A\u043E\u0433\u0434\u0430 \u0432\u0438\u0436\u0443 \u0442\u0435\u043B\u0430\xBB."
  - id: sign
    shard: 1
    shards: 2
    requiredFlag: 
    text: "\u0412\u0437\u044F\u043B \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B."
