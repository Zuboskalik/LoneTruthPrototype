  id: ch1_callahan
  title: "\u041A\u0443\u0440\u043E\u043A \u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D\u0430"
  isMainQuest: 1
  failFlag: 
  stages:
  - flag: choice_callahan
    text: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D \u043B\u0435\u0436\u0438\u0442 \u0441\u0440\u0435\u0434\u0438 \u044F\u0449\u0438\u043A\u043E\u0432 \u0441 \u0434\u0438\u043D\u0430\u043C\u0438\u0442\u043E\u043C."
  outcomes:
  - id: spare
    shard: 0
    shards: 2
    requiredFlag: 
    text: "\u041F\u043E\u0449\u0430\u0434\u0438\u043B \u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D\u0430 \u0438 \u043E\u0442\u0434\u0430\u043B \u0448\u0435\u0440\u0438\u0444\u0443."
  - id: leave
    shard: 1
    shards: 2
    requiredFlag: 
    text: "\u041E\u0441\u0442\u0430\u0432\u0438\u043B \u0435\u0433\u043E \u0443 \u0433\u043E\u0440\u044F\u0449\u0435\u0433\u043E \u0448\u043D\u0443\u0440\u0430."
  - id: truth
    shard: 2
    shards: 2
    requiredFlag: KEY_TITHE
    text: "\xAB\u041A\u0442\u043E \u043E\u0442\u0434\u0430\u0451\u0442 \u043F\u0440\u0438\u043A\u0430\u0437\u044B \u0423\u0438\u0442\u043B\u043E\u043A\u0443?\xBB \u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0441\u044F: \u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043F\u0438\u0441\u044C\u043C\u0430 \u0438\u0437 \u0448\u0430\u0445\u0442\u044B, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435 \u0440\u0443\u043A\u043E\u0439 \u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0433\u043E \u0434\u0435\u0434\u0430."
