  title: "\u0413\u0443\u0431\u043D\u0430\u044F \u0433\u0430\u0440\u043C\u043E\u0448\u043A\u0430 \u043E\u0442\u0446\u0430"
  place: "\u041A\u043B\u0430\u0434\u0431\u0438\u0449\u0435, \u043C\u043E\u0433\u0438\u043B\u0430 \u042D\u0434\u0433\u0430\u0440\u0430 \u0425\u043E\u043B\u0442\u0430"
  description: "\u0415\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435, \u0447\u0442\u043E \u043B\u0435\u0436\u0430\u043B\u043E \u0432 \u0433\u0440\u043E\u0431\u0443 \u043E\u0442\u0446\u0430. \u0412 \u0442\u043E \u0443\u0442\u0440\u043E 1906 \u0433\u043E\u0434\u0430 \u043E\u043D \u0437\u0430\u0431\u044B\u043B \u0435\u0451 \u0434\u043E\u043C\u0430, \u0438 \u043C\u0430\u0442\u044C \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0430 \u0435\u0451 \u0432\u043C\u0435\u0441\u0442\u043E \u0442\u0435\u043B\u0430."
