  notes:
  - flag: clue_shell_45
    text: "\u0423 \u0437\u0430\u0434\u043D\u0435\u0433\u043E \u043A\u0440\u044B\u043B\u044C\u0446\u0430 \u043A\u043E\u043D\u0442\u043E\u0440\u044B \u2014 \u0433\u0438\u043B\u044C\u0437\u0430 .45. \u0415\u0433\u043E \u043A\u0430\u043B\u0438\u0431\u0440."
