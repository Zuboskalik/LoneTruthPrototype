  role: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u043E\u0445\u0440\u0430\u043D\u044B \xAB\u0423\u0438\u0442\u043B\u043E\u043A \u041C\u0430\u0439\u043D\u0438\u043D\u0433\xBB"
  description: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u043C\u0435\u043D\u044F \u043D\u0430 \u043F\u0435\u0440\u0440\u043E\u043D\u0435: \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u043C\u0435\u043D\u044F \u0436\u0434\u0430\u043B\u0430. \u041F\u0440\u043E\u0432\u043E\u0434\u0438\u043B \u0434\u043E \u0441\u0430\u043B\u0443\u043D\u0430. \u041D\u0430 \u043F\u043E\u044F\u0441\u0435 \u043A\u043E\u043B\u044C\u0442 .45."
