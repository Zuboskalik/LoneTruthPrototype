  displayName: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
  knownFlag: 
  role: "\u0412\u0434\u043E\u0432\u0430 \u0448\u0430\u0445\u0442\u0451\u0440\u0430 \u0422\u043E\u043C\u0430\u0441\u0430 \u0411\u0438\u0440\u043D\u0430"
  description: "\u041D\u0430\u043F\u0438\u0441\u0430\u043B\u0430 \u043C\u043D\u0435 \u0432 \u0427\u0438\u043A\u0430\u0433\u043E: \xAB\u0422\u043E\u043C\u0430\u0441 \u0436\u0438\u0432. \u041E\u043D \u043F\u0438\u0448\u0435\u0442 \u043C\u043D\u0435 \u043F\u043E \u043D\u043E\u0447\u0430\u043C. \u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C \u043F\u0438\u0441\u044C\u043C\u0435 \u043E\u043D \u043D\u0430\u0437\u0432\u0430\u043B \u0432\u0430\u0448\u0435 \u0438\u043C\u044F\xBB."
  portrait: {fileID: 0}
  notes:
  - flag: q1_1_started
    text: "\u041F\u043E\u043A\u0430\u0437\u0430\u043B\u0430 \u0441\u0435\u043C\u044C \u043F\u0438\u0441\u0435\u043C \u0422\u043E\u043C\u0430\u0441\u0430. \u041E\u043D\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043D\u0430 \u0435\u0451 \u043F\u043E\u0434\u043E\u043A\u043E\u043D\u043D\u0438\u043A\u0435 \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C, \u0438 \u043E\u043D\u0430 \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430, \u043A\u0442\u043E \u0438\u0445 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442."
