  id: 1_3
  title: "\u041D\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u043B\u043E\u043A\u043E\u043B"
  isMainQuest: 0
  failFlag: 
  stages:
  - flag: q1_3_started
    text: "\u041A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C \u0432 4:17 \u0437\u0432\u043E\u043D\u0438\u0442 \u043A\u043E\u043B\u043E\u043A\u043E\u043B \u0447\u0430\u0441\u043E\u0432\u043D\u0438, \u0445\u043E\u0442\u044F \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044F \u0437\u0430\u043F\u0435\u0440\u0442\u0430. \u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u044C \u043F\u0440\u0438\u0447\u0438\u043D\u0443 \u2014 \u0438 \u044F\u0432\u043D\u043E \u0447\u0435\u0433\u043E-\u0442\u043E \u0431\u043E\u0438\u0442\u0441\u044F."
  outcomes:
  - id: hope
    shard: 0
    shards: 1
    requiredFlag: 
    text: "\u041F\u0440\u043E\u0441\u0442\u0438\u043B \u043E\u0442\u0446\u0430 \u041C\u044D\u0442\u044C\u044E \u0438 \u0443\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C \u043B\u044E\u0434\u044F\u043C."
  - id: despair
    shard: 1
    shards: 1
    requiredFlag: 
    text: "\u0428\u0430\u043D\u0442\u0430\u0436\u0438\u0440\u043E\u0432\u0430\u043B \u043E\u0442\u0446\u0430 \u041C\u044D\u0442\u044C\u044E \u043A\u043D\u0438\u0433\u043E\u0439 \u0438 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438."
  - id: truth
    shard: 2
    shards: 1
    requiredFlag: clue_token_1882
    text: "\xAB\u0427\u044C\u0438 \u0433\u0440\u043E\u0431\u044B \u043F\u0443\u0441\u0442\u044B\u0435?\xBB \u0421\u0440\u0435\u0434\u0438 \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0445 1906 \u0433\u043E\u0434\u0430 \u2014 \u042D\u0434\u0433\u0430\u0440 \u0425\u043E\u043B\u0442. \u041C\u043E\u0439 \u043E\u0442\u0435\u0446."
