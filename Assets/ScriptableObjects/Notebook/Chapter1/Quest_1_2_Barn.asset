  id: 1_2
  title: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u0432 \u0441\u0430\u0440\u0430\u0435"
  isMainQuest: 0
  failFlag: 
  stages:
  - flag: ruth_rumor_barn
    text: "\u0420\u0443\u0444\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0441\u043E\u0431\u0430\u043A\u0438 \u0442\u0440\u0435\u0442\u044C\u044E \u043D\u043E\u0447\u044C \u043B\u0430\u044E\u0442 \u043D\u0430 \u0441\u0430\u0440\u0430\u0439 \u0437\u0430 \u043A\u043E\u043D\u044E\u0448\u043D\u0435\u0439. \u0421\u0430\u0440\u0430\u0439 \u2014 \u0432 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0435 \u0437\u0430 \u0434\u043E\u043C\u043E\u043C \u0410\u0433\u043D\u0435\u0441."
  - flag: q1_2_found_jesse
    text: "\u0412 \u0441\u0430\u0440\u0430\u0435 \u043F\u0440\u044F\u0447\u0435\u0442\u0441\u044F \u0440\u0430\u043D\u0435\u043D\u044B\u0439 \u0448\u0430\u0445\u0442\u0451\u0440 \u0414\u0436\u0435\u0441\u0441\u0438 \u041A\u043E\u0443\u043B. \u041F\u0440\u043E\u0441\u0438\u0442 \u0431\u0438\u043D\u0442 \u0438 \u0432\u0438\u0441\u043A\u0438, \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u043E\u0442\u0434\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u0443 \u043D\u0438\u0436\u043D\u0438\u0445 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u0432."
  outcomes:
  - id: hope
    shard: 0
    shards: 1
    requiredFlag: 
    text: "\u041E\u0442\u0434\u0430\u043B \u0441\u0432\u043E\u0439 \u0431\u0438\u043D\u0442; \u043E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E \u0441\u043F\u0440\u044F\u0447\u0435\u0442 \u0414\u0436\u0435\u0441\u0441\u0438 \u0432 \u0440\u0438\u0437\u043D\u0438\u0446\u0435."
  - id: despair
    shard: 1
    shards: 1
    requiredFlag: 
    text: "\u0417\u0430\u0431\u0440\u0430\u043B \u043A\u0430\u0440\u0442\u0443 \u0438 \u0443\u0448\u0451\u043B."
  - id: truth
    shard: 2
    shards: 1
    requiredFlag: clue_shell_45
    text: "\xAB\u0422\u0435\u0431\u044F \u043D\u0435 \u043A\u0430\u043C\u043D\u0435\u043C \u0437\u0430\u0434\u0435\u043B\u043E. \u041A\u0442\u043E \u0441\u0442\u0440\u0435\u043B\u044F\u043B?\xBB \u0414\u0436\u0435\u0441\u0441\u0438 \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A \u043B\u044E\u0434\u0438 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438 \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B\u0438 \u0437\u0430\u0440\u044F\u0434\u044B \u0437\u0430 \u0447\u0430\u0441 \u0434\u043E \u043E\u0431\u0432\u0430\u043B\u0430. \u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D \u0441\u0442\u0440\u0435\u043B\u044F\u043B \u0435\u043C\u0443 \u0432\u0441\u043B\u0435\u0434."
