  displayName: "\u0420\u0443\u0444\u044C \u041C\u0430\u043A\u043A\u0435\u043D\u0437\u0438"
  knownFlag: saloon_checkin
  role: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0441\u0430\u043B\u0443\u043D\u0430 \xAB\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043B\u0430\u043C\u043F\u0430\xBB"
  description: "\u0421\u0434\u0430\u043B\u0430 \u043C\u043D\u0435 \u0442\u0440\u0435\u0442\u0438\u0439 \u043D\u043E\u043C\u0435\u0440: \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u043F\u043B\u0430\u0442\u0438\u0442. \u0417\u043D\u0430\u0435\u0442 \u0432\u0441\u0451, \u0447\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435."
  portrait: {fileID: 885002548, guid: 9367516e95135174395af0980c835309, type: 3}
  notes:
  - flag: ruth_rumor_barn
    text: "\u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0441\u043E\u0431\u0430\u043A\u0438 \u0442\u0440\u0435\u0442\u044C\u044E \u043D\u043E\u0447\u044C \u043B\u0430\u044E\u0442 \u043D\u0430 \u0441\u0430\u0440\u0430\u0439 \u0437\u0430 \u043A\u043E\u043D\u044E\u0448\u043D\u0435\u0439."
