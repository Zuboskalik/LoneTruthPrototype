  m_Script: {fileID: 11500000, guid: 96bfab2313a789342a4be8fd2f82531f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: clue_ledger
  steps:
  - type: 7
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 8.8
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0413\u0440\u043E\u0441\u0441\u0431\u0443\u0445 \u0434\u043E\u0431\u044B\u0447\u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u0430. 1882, 1906, 1936: \u043F\u0435\u0440\u0435\u0434 \u043A\u0430\u0436\u0434\u044B\u043C \u043E\u0431\u0432\u0430\u043B\u043E\u043C \u0436\u0438\u043B\u0430 \u0438\u0441\u0441\u044F\u043A\u0430\u0435\u0442."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041D\u0430 \u043F\u043E\u043B\u044F\u0445 \u043E\u0434\u043D\u0430 \u0438 \u0442\u0430 \u0436\u0435 \u043F\u043E\u043C\u0435\u0442\u043A\u0430: \xAB\u0414. \u0443\u043F\u043B\u0430\u0447\u0435\u043D\u0430\xBB. \u0418 \u0432\u0440\u0435\u043C\u044F: 4:17."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0427\u0435\u0440\u0435\u0437 \u043C\u0435\u0441\u044F\u0446 \u043F\u043E\u0441\u043B\u0435 \u043E\u0431\u0432\u0430\u043B\u043E\u0432 1882 \u0438 1906 \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u043D\u043E\u0432\u0443\u044E \u0431\u043E\u0433\u0430\u0442\u0443\u044E \u0436\u0438\u043B\u0443. \u0412 1936-\u043C \u0435\u0451 \u043D\u0435\u0442."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u0423\u043B\u0438\u043A\u0430 \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435: \u0433\u0440\u043E\u0441\u0441\u0431\u0443\u0445. \u0421\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0435\u0433\u043E \u0441 \u043A\u043D\u0438\u0433\u043E\u0439 \u0441\u043C\u0435\u0440\u0442\u0435\u0439 (Tab)"
