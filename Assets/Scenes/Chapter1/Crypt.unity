  doneFlag: crypt_warned
  steps:
  - type: 5
    speaker: 
    text: "\u0422\u0435\u043C\u043D\u043E, \u0445\u043E\u0442\u044C \u0433\u043B\u0430\u0437 \u043A\u043E\u043B\u0438. \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043A\u0442\u043E-\u0442\u043E \u0434\u044B\u0448\u0438\u0442, \u0445\u043E\u0442\u044F \u0434\u044B\u0448\u0430\u0442\u044C \u0442\u0443\u0442 \u043D\u0435\u0447\u0435\u043C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u041F\u0443\u0441\u0442\u043E\u0439 \u0441\u043F\u0438\u0442. \u0415\u0433\u043E \u0431\u0443\u0434\u0438\u0442 \u0448\u0443\u043C \u0438 \u043E\u0433\u043E\u043D\u044C: \u0432\u044B\u0441\u0442\u0440\u0435\u043B, \u0444\u0430\u043B\u044C\u0448\u0444\u0435\u0439\u0435\u0440, \u043F\u0435\u0440\u0435\u043A\u0430\u0442. \u0418\u0434\u0438 \u0448\u0430\u0433\u043E\u043C."
