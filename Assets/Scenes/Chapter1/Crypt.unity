  - type: 15
    speaker: 
    text: "\u041E\u043F\u0443\u0449\u0435\u043D \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0432\u0435\u0441. \u0412\u0441\u0435\u0433\u043E \u0438\u0445 \u0442\u0440\u0438: \u043D\u0435\u0444, \u0440\u0438\u0437\u043D\u0438\u0446\u0430, \u043A\u0440\u0438\u043F\u0442\u0430"
