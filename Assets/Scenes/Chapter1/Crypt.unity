  doneFlag: crypt_warned
  steps:
  - type: 5
    speaker: 
    text: "\u0422\u0435\u043C\u043D\u043E, \u0445\u043E\u0442\u044C \u0433\u043B\u0430\u0437 \u043A\u043E\u043B\u0438. \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043A\u0442\u043E-\u0442\u043E \u0434\u044B\u0448\u0438\u0442, \u0445\u043E\u0442\u044F \u0434\u044B\u0448\u0430\u0442\u044C \u0442\u0443\u0442 \u043D\u0435\u0447\u0435\u043C."
