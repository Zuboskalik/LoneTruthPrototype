  steps:
  - type: 5
    speaker: 
    text: "\u0422\u0440\u0435\u0442\u0438\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0432\u0435\u0441. \u0426\u0435\u043F\u044C \u043F\u043E\u0448\u043B\u0430 \u0432\u043D\u0438\u0437. \u041D\u0430\u0432\u0435\u0440\u0445\u0443 \u0447\u0442\u043E-\u0442\u043E \u0449\u0451\u043B\u043A\u043D\u0443\u043B\u043E."
