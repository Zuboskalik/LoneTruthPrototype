  m_Script: {fileID: 11500000, guid: 96bfab2313a789342a4be8fd2f82531f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: sheriff_report
  steps:
  - type: 7
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 4.6
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0428\u0435\u0440\u0438\u0444 \u0414\u043E\u043B\u0430\u043D"
    text: "\u0427\u0438\u043A\u0430\u0433\u0441\u043A\u0438\u0439 \u0441\u044B\u0449\u0438\u043A. \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0430, \u0447\u0442\u043E \u0432\u044B \u0437\u0430\u0439\u0434\u0451\u0442\u0435."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u043E\u0442\u0447\u0451\u0442 \u043E\u0431 \u043E\u0431\u0432\u0430\u043B\u0435."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 22
    speaker: 
    text: 
    actor: {fileID: 1542053836}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: React
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0428\u0435\u0440\u0438\u0444 \u0414\u043E\u043B\u0430\u043D"
    text: "\u041E\u0442\u0447\u0451\u0442\u2026 \u0412\u043E\u0442. \u041F\u043E\u0434\u043F\u0438\u0441\u0430\u043D, \u0437\u0430\u0432\u0435\u0440\u0435\u043D. \u041D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0439 \u0441\u043B\u0443\u0447\u0430\u0439, \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 11
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: clue_collapse_report
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u0423\u043B\u0438\u043A\u0430 \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435: \u043E\u0442\u0447\u0451\u0442 \u0448\u0435\u0440\u0438\u0444\u0430 \u043E\u0431 \u043E\u0431\u0432\u0430\u043B\u0435"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 3.5
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u0412 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0447\u0430\u0441\u0443 \u044D\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0428\u0435\u0440\u0438\u0444 \u0414\u043E\u043B\u0430\u043D"
    text: "\u041D\u043E\u0447\u044C\u044E. \u0412\u0437\u0440\u044B\u0432\u0430\u043B\u0438 \u0432 4:17."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0428\u0435\u0440\u0438\u0444 \u0414\u043E\u043B\u0430\u043D"
    text: "\u0412\u0437\u0440\u044B\u0432\u0430\u043B\u0438, \u044F \u0441\u043A\u0430\u0437\u0430\u043B? \u041E\u0431\u0440\u0443\u0448\u0438\u043B\u043E\u0441\u044C. \u041E\u0431\u0440\u0443\u0448\u0438\u043B\u043E\u0441\u044C \u0432 4:17."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "4:17. \u0427\u0430\u0441\u044B \u043E\u0442\u0446\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u0432 4:17 \u2014 \u043A\u043E\u0433\u0434\u0430 \u0435\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u043E \u0432 \u044D\u0442\u043E\u0439 \u0448\u0430\u0445\u0442\u0435 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0421\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435. \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 14
    speaker: 
    text: "\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435. \u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0432 \u0434\u0435\u043B\u0430 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u2014 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0432 \u043D\u043E\u043C\u0435\u0440\u0435 \u0434\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u044B."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
