  - type: 5
    speaker: 
    text: "4:17. \u0427\u0430\u0441\u044B \u043E\u0442\u0446\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C \u0432 4:17 \u2014 \u043A\u043E\u0433\u0434\u0430 \u0435\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u043E \u0432 \u044D\u0442\u043E\u0439 \u0448\u0430\u0445\u0442\u0435 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434."
