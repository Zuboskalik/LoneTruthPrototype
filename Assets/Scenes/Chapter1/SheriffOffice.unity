  - type: 5
    speaker: "\u0428\u0435\u0440\u0438\u0444 \u0414\u043E\u043B\u0430\u043D"
    text: "\u041E\u0442\u0447\u0451\u0442\u2026 \u0412\u043E\u0442. \u041F\u043E\u0434\u043F\u0438\u0441\u0430\u043D, \u0437\u0430\u0432\u0435\u0440\u0435\u043D. \u041D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u0439 \u0441\u043B\u0443\u0447\u0430\u0439, \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
