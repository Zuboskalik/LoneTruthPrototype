  m_Script: {fileID: 11500000, guid: 96bfab2313a789342a4be8fd2f82531f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: q1_1_started
  steps:
  - type: 7
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 4.8
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u041C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442? \u0412\u044B \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438. \u042F \u0437\u043D\u0430\u043B\u0430, \u0447\u0442\u043E \u043F\u0440\u0438\u0435\u0434\u0435\u0442\u0435."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u0412\u0430\u0448\u0435 \u043F\u0438\u0441\u044C\u043C\u043E, \u043C\u0438\u0441\u0441\u0438\u0441 \u0411\u0438\u0440\u043D. \u0422\u043E\u043C\u0430\u0441 \u043F\u0438\u0448\u0435\u0442 \u0432\u0430\u043C?"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u0421\u0435\u043C\u044C \u043F\u0438\u0441\u0435\u043C. \u0415\u0433\u043E \u0440\u0443\u043A\u0430, \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430. \u0418 \u0443\u0433\u043E\u043B\u044C\u043D\u0430\u044F \u043F\u044B\u043B\u044C \u043D\u0430 \u0441\u0433\u0438\u0431\u0430\u0445."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u041E\u043D\u0438 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u0434\u043E\u043A\u043E\u043D\u043D\u0438\u043A\u0435. \u041A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C. \u042F \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430, \u043A\u0442\u043E \u0438\u0445 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u2014 \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u043E. \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u0410 \u043C\u043E\u0439 \u043C\u0443\u0436 \u043F\u0438\u0448\u0435\u0442 \u043C\u043D\u0435 \u043F\u043E \u043D\u043E\u0447\u0430\u043C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041A\u0442\u043E-\u0442\u043E \u0436\u0435 \u0438\u0445 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442. \u041D\u043E\u0447\u044C\u044E \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C \u0432 \u0442\u0435\u043D\u0438 \u0443 \u0435\u0451 \u043E\u043A\u043D\u0430."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u041D\u043E\u0432\u043E\u0435 \u0434\u0435\u043B\u043E \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435: \xAB\u041F\u0438\u0441\u044C\u043C\u0430 \u0438\u0437-\u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0438\xBB"
