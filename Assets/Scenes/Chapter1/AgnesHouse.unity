  m_Script: {fileID: 11500000, guid: 96bfab2313a789342a4be8fd2f82531f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: clue_thomas_old_letter
  steps:
  - type: 5
    speaker: "\u0410\u0433\u043D\u0435\u0441 \u0411\u0438\u0440\u043D"
    text: "\u0412 \u043A\u043E\u043C\u043E\u0434\u0435 \u2014 \u0435\u0433\u043E \u043F\u0438\u0441\u044C\u043C\u043E, \u0435\u0449\u0451 \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u043B. \u0421\u0440\u0430\u0432\u043D\u0438\u0442\u0435, \u0435\u0441\u043B\u0438 \u0445\u043E\u0442\u0438\u0442\u0435."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0421\u0442\u0430\u0440\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E \u0422\u043E\u043C\u0430\u0441\u0430. \u0422\u043E\u0442 \u0436\u0435 \u043D\u0430\u043A\u043B\u043E\u043D, \u0442\u0430 \u0436\u0435 \u0440\u0443\u043A\u0430, \u0447\u0442\u043E \u0438 \u0432 \u043D\u043E\u0447\u043D\u044B\u0445 \u043F\u0438\u0441\u044C\u043C\u0430\u0445."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u0423\u043B\u0438\u043A\u0430 \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435: \u0441\u0442\u0430\u0440\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E \u0422\u043E\u043C\u0430\u0441\u0430"
