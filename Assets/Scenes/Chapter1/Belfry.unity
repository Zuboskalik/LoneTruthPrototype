    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0421\u0442\u0430\u0440\u0438\u043A \u0442\u044F\u043D\u0435\u0442 \u0432\u0435\u0440\u0451\u0432\u043A\u0443. \u041D\u0435\u043C\u043E\u0439: \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0443\u0431\u044B \u0448\u0435\u0432\u0435\u043B\u044F\u0442\u0441\u044F \u0432 \u0442\u0430\u043A\u0442."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041E\u043D \u0437\u0432\u043E\u043D\u0438\u0442, \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043A\u043E\u043B\u043E\u043A\u043E\u043B \u043D\u0435 \u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0438\u0445 \u0432 \u0433\u043E\u0440\u043E\u0434. \u041D\u0435 \u0441 \u043A\u0435\u043C \u043E\u0431 \u044D\u0442\u043E\u043C \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u041D\u0435\u043A\u043E\u043C\u0443 \u0438 \u0441\u043A\u0430\u0437\u0430\u0442\u044C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 22
    speaker: 
    text: 
    actor: {fileID: 531435214}
    target: {fileID: 0}
