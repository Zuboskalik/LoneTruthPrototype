    spawnId: 
    dialogue: {fileID: 0}
  - type: 4
    speaker: 
    text: "\xAB\u0421\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442. \u0421\u043F\u0440\u043E\u0441\u0438 \u043F\u0440\u043E \u043A\u043D\u0438\u0433\u0443\xBB."
