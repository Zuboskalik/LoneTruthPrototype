    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430. \u041E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F, \u0432 \u0440\u0443\u043A\u0435 \u043A\u043E\u043D\u0432\u0435\u0440\u0442."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 11
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 0
    key: alley_hidden
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u0421\u0442\u043E\u0439, \u043F\u0430\u0440\u0435\u043D\u044C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 22
    speaker: 
    text: 
    actor: {fileID: 85380618}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: React
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041B\u0438\u0430\u043C"
    text: "\u041D\u0435 \u043D\u0430\u0434\u043E, \u043C\u0438\u0441\u0442\u0435\u0440! \u042F \u043D\u0438\u0447\u0435\u0433\u043E \u043F\u043B\u043E\u0445\u043E\u0433\u043E!"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u041E\u0442\u043A\u0443\u0434\u0430 \u043F\u0438\u0441\u044C\u043C\u0430?"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041B\u0438\u0430\u043C"
    text: "\u041E\u043D\u0438 \u0441\u0430\u043C\u0438 \u0432\u044B\u043B\u0435\u0442\u0430\u044E\u0442! \u0421 \u0442\u044F\u0433\u043E\u0439, \u0438\u0437 \u0441\u043A\u0432\u0430\u0436\u0438\u043D\u044B \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435. \u042F \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044E \u0438 \u043D\u043E\u0448\u0443 \u043C\u0438\u0441\u0441\u0438\u0441 \u0411\u0438\u0440\u043D."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041B\u0438\u0430\u043C"
    text: "\u0421\u043A\u0432\u0430\u0436\u0438\u043D\u0430 \u0438\u0434\u0451\u0442 \u0432\u043D\u0438\u0437, \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442. \u0420\u0435\u0448\u0451\u0442\u043A\u0430 \u0442\u0430\u043C \u0440\u0436\u0430\u0432\u0430\u044F, \u0435\u0451 \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u043E\u043C\u043E\u043C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 22
    speaker: 
    text: 
    actor: {fileID: 85380618}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: Gesture
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041B\u0438\u0430\u043C"
    text: "\u0412\u043E\u0442, \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0435. \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438!"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 6
    speaker: 
    text: 
    actor: {fileID: 85380618}
    target: {fileID: 0}
    x: 19.5
