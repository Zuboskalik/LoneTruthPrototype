  - type: 14
    speaker: 
    text: "\u0422\u0440\u043E\u043F\u0430 \u0432 \u043A\u043E\u043D\u0446\u0435 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0430 \u0432\u0435\u0434\u0451\u0442 \u043A \u0441\u043A\u0432\u0430\u0436\u0438\u043D\u0435. \u041D\u0443\u0436\u0435\u043D \u043B\u043E\u043C."
