  - type: 5
    speaker: "\u041B\u0438\u0430\u043C"
    text: "\u0421\u043A\u0432\u0430\u0436\u0438\u043D\u0430 \u0438\u0434\u0451\u0442 \u0432\u043D\u0438\u0437, \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442. \u0420\u0435\u0448\u0451\u0442\u043A\u0430 \u0442\u0430\u043C \u0440\u0436\u0430\u0432\u0430\u044F, \u0435\u0451 \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u043E\u043C\u043E\u043C."
