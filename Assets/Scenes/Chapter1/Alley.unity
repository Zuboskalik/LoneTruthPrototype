  - type: 15
    speaker: 
    text: "\u041B\u043E\u043C \u2014 \u0443 \u0420\u0443\u0444\u0438 \u0437\u0430 $15 \u0438\u043B\u0438 \u0432 \u0441\u0430\u0440\u0430\u0435, \u0440\u044F\u0434\u043E\u043C \u0441 \u0414\u0436\u0435\u0441\u0441\u0438."
    actor: {fileID: 0}
