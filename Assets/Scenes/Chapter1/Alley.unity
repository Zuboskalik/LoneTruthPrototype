    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041B\u0438\u0430\u043C"
    text: "\u041E\u043D\u0438 \u0441\u0430\u043C\u0438 \u0432\u044B\u043B\u0435\u0442\u0430\u044E\u0442! \u0421 \u0442\u044F\u0433\u043E\u0439, \u0438\u0437 \u0441\u043A\u0432\u0430\u0436\u0438\u043D\u044B \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435. \u042F \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044E \u0438 \u043D\u043E\u0448\u0443 \u043C\u0438\u0441\u0441\u0438\u0441 \u0411\u0438\u0440\u043D."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041B\u0438\u0430\u043C"
    text: "\u0421\u043A\u0432\u0430\u0436\u0438\u043D\u0430 \u0438\u0434\u0451\u0442 \u0432\u043D\u0438\u0437, \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442. \u0420\u0435\u0448\u0451\u0442\u043A\u0430 \u0442\u0430\u043C \u0440\u0436\u0430\u0432\u0430\u044F, \u0435\u0451 \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u043E\u043C\u043E\u043C."
    actor: {fileID: 0}
    target: {fileID: 0}
