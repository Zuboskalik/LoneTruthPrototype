    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041E\u043D \u043D\u0430 \u0432\u0437\u0432\u043E\u0434\u0435. \u0420\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u043B\u0443\u0447\u0448\u0435 \u0443\u0431\u0440\u0430\u0442\u044C (\u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0433\u043E \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 G)."
