    x: 11.6
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A"
    text: "\u041C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442. \u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A. \u0420\u0430\u0434, \u0447\u0442\u043E \u0432\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A"
    text: "\u0417\u0430\u0434\u0430\u0447\u0430 \u043F\u0440\u043E\u0441\u0442\u0430\u044F: \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u0433\u0438\u0431\u0435\u043B\u044C \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u0442\u0440\u0451\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0438 \u0432\u0438\u043D\u0443 \u043F\u0440\u043E\u0444\u0441\u043E\u044E\u0437\u043D\u044B\u0445 \u0441\u0430\u0431\u043E\u0442\u0430\u0436\u043D\u0438\u043A\u043E\u0432."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
