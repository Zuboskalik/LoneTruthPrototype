  - type: 5
    speaker: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A"
    text: "\u041E\u0442\u0447\u0451\u0442 \u2014 \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u043E\u0440\u0435\u0435. \u0427\u0435\u043C \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u044B \u0443\u0435\u0434\u0435\u0442\u0435, \u0442\u0435\u043C \u043B\u0443\u0447\u0448\u0435. \u0414\u043B\u044F \u0432\u0441\u0435\u0445."
    actor: {fileID: 0}
