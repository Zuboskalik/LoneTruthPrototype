  - type: 5
    speaker: "\u0421\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044C"
    text: "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E, \u043C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442. \u041C\u0438\u0441\u0442\u0435\u0440 \u0423\u0438\u0442\u043B\u043E\u043A \u0432\u0430\u0441 \u0436\u0434\u0451\u0442 \u2014 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435, \u043F\u0440\u043E\u0448\u0443."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 7
    speaker: 
