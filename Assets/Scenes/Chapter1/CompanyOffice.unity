  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: office_meeting
  steps:
  - type: 7
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 11.6
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
  - type: 5
    speaker: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A"
    text: "\u041C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442. \u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A. \u0420\u0430\u0434, \u0447\u0442\u043E \u0432\u044B \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
  - type: 5
    speaker: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A"
    text: "\u0417\u0430\u0434\u0430\u0447\u0430 \u043F\u0440\u043E\u0441\u0442\u0430\u044F: \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u0433\u0438\u0431\u0435\u043B\u044C \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u0442\u0440\u0451\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0438 \u0432\u0438\u043D\u0443 \u043F\u0440\u043E\u0444\u0441\u043E\u044E\u0437\u043D\u044B\u0445 \u0441\u0430\u0431\u043E\u0442\u0430\u0436\u043D\u0438\u043A\u043E\u0432."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
  - type: 5
    speaker: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A"
    text: "\u0421\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u044F \u0432\u044B\u043F\u043B\u0430\u0442\u0438\u0442, \u0448\u0430\u0445\u0442\u0443 \u0437\u0430\u043A\u0440\u043E\u0435\u043C, \u0438 \u0433\u043E\u0440\u043E\u0434 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0432\u044B\u0434\u043E\u0445\u043D\u0435\u0442."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u0410 \u0435\u0441\u043B\u0438 \u0441\u0430\u0431\u043E\u0442\u0430\u0436\u043D\u0438\u043A\u043E\u0432 \u043D\u0435 \u0431\u044B\u043B\u043E?"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
  - type: 5
    speaker: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A"
    text: "\u0422\u043E\u0433\u0434\u0430 \u0432\u044B \u0438\u0445 \u043D\u0430\u0439\u0434\u0451\u0442\u0435. \u0412\u043E\u0442 \u0430\u0432\u0430\u043D\u0441 \u2014 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u043E\u043B\u043B\u0430\u0440\u043E\u0432. \u0418 \u043F\u0440\u043E\u043F\u0443\u0441\u043A \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
  - type: 13
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 50
    scene: 
    spawnId: 
  - type: 12
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 11400000, guid: a71aea76c76426c47a0148675cf3c08a, type: 2}
    amount: 1
    scene: 
    spawnId: 
  - type: 5
    speaker: "\u041A\u043E\u0440\u043D\u0435\u043B\u0438\u0443\u0441 \u0423\u0438\u0442\u043B\u043E\u043A"
    text: "\u041E\u0442\u0447\u0451\u0442 \u2014 \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0441\u043A\u043E\u0440\u0435\u0435. \u0427\u0435\u043C \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u044B \u0443\u0435\u0434\u0435\u0442\u0435, \u0442\u0435\u043C \u043B\u0443\u0447\u0448\u0435. \u0414\u043B\u044F \u0432\u0441\u0435\u0445."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
  - type: 5
    speaker: 
    text: "\u041E\u043D \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u0435\u0442. \u0418 \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0435 \u043D\u0430 \u043C\u0435\u043D\u044F \u2014 \u043D\u0430 \u043F\u043E\u0440\u0442\u0440\u0435\u0442 \u0437\u0430 \u043C\u043E\u0435\u0439 \u0441\u043F\u0438\u043D\u043E\u0439."
