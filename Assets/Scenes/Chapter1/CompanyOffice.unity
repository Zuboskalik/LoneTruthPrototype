    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0410 \u043F\u043E\u0434 \u043D\u0435\u0439 \u0441\u0432\u0435\u0436\u0438\u0435 \u0446\u0432\u0435\u0442\u044B. \u041A\u0442\u043E-\u0442\u043E \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u0437\u0430 \u043C\u0451\u0440\u0442\u0432\u044B\u043C \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E \u043E\u043D \u0435\u0449\u0451 \u0437\u0434\u0435\u0441\u044C."
    actor: {fileID: 0}
    target: {fileID: 0}
