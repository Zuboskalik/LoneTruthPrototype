  - type: 4
    speaker: 
    text: "\u0413\u043B\u0430\u0432\u0430 1 \xB7 \u0414\u0435\u043D\u044C 1\n\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
