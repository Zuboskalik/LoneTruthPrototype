  - type: 5
    speaker: "\u0420\u0443\u0444\u044C"
    text: "\u0412\u044B \u043E\u0442 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438. \u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u043B."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0420\u0443\u0444\u044C"
    text: "\u0422\u0440\u0435\u0442\u0438\u0439 \u043D\u043E\u043C\u0435\u0440, \u043D\u0430\u0432\u0435\u0440\u0445\u0443. \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u043F\u043B\u0430\u0442\u0438\u0442 \u2014 \u0437\u043D\u0430\u0447\u0438\u0442, \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432 \u044F \u043D\u0435 \u0437\u0430\u0434\u0430\u044E."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 12
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 11400000, guid: 651d29d44642a7a4b91e14cc5b8ab7a5, type: 2}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0420\u0443\u0444\u044C"
    text: "\u041D\u043E\u0447\u044C\u044E \u043F\u043E \u0443\u043B\u0438\u0446\u0435 \u043D\u0435 \u0445\u043E\u0434\u0438\u0442\u0435. \u0418 \u0435\u0441\u043B\u0438 \u0437\u0430\u0437\u0432\u043E\u043D\u0438\u0442 \u043A\u043E\u043B\u043E\u043A\u043E\u043B \u2014 \u043E\u043A\u043D\u0430 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0439\u0442\u0435."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0422\u0451\u043F\u043B\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. \u0417\u0434\u0435\u0441\u044C \u0447\u0442\u043E-\u0442\u043E \u0437\u043D\u0430\u044E\u0442 \u2014 \u0438 \u043C\u043E\u043B\u0447\u0430\u0442."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 14
    speaker: 
    text: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u0432 \u043D\u043E\u043C\u0435\u0440 3 (\u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430 \u0441\u043F\u0440\u0430\u0432\u0430)."
