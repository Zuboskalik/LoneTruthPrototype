    text: "\u041F\u043E\u043D\u0430\u0434\u043E\u0431\u044F\u0442\u0441\u044F \u043F\u0430\u0442\u0440\u043E\u043D\u044B, \u0431\u0438\u043D\u0442\u044B \u0438\u043B\u0438 \u0432\u0438\u0441\u043A\u0438 \u2014 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435 \u043A \u0441\u0442\u043E\u0439\u043A\u0435. \u042F \u0437\u0430 \u043D\u0435\u0439 \u0438 \u0434\u043D\u0451\u043C, \u0438 \u043D\u043E\u0447\u044C\u044E."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 14
    speaker: 
    text: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u0432 \u043D\u043E\u043C\u0435\u0440 3 (\u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430 \u0441\u043F\u0440\u0430\u0432\u0430)."
    actor: {fileID: 0}
    target: {fileID: 0}
