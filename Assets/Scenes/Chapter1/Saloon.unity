    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0420\u0443\u0444\u044C"
    text: "\u0421\u043B\u044B\u0448\u0438\u0442\u0435 \u043A\u043E\u043B\u043E\u043A\u043E\u043B, \u043C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442? \u0417\u043D\u0430\u0447\u0438\u0442, \u043E\u043D\u0438 \u043E\u043F\u044F\u0442\u044C \u043D\u0430\u0432\u0435\u0440\u0445\u0443."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u041A\u0442\u043E \u2014 \u043E\u043D\u0438?"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0420\u0443\u0444\u044C"
    text: "\u0421\u0430\u043C\u0438 \u0443\u0432\u0438\u0434\u0438\u0442\u0435. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435. \u042D\u0442\u043E\u0433\u043E \u043E\u043D\u0438 \u0431\u043E\u044F\u0442\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043F\u0443\u043B\u0438."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 12
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
