    speaker: "\u0420\u0443\u0444\u044C"
    text: "\u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D \u0437\u0430\u0445\u043E\u0434\u0438\u043B \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u041C\u0438\u0441\u0442\u0435\u0440 \u0423\u0438\u0442\u043B\u043E\u043A \u0436\u0434\u0451\u0442 \u0432\u0430\u0441 \u0432 \u043A\u043E\u043D\u0442\u043E\u0440\u0435."
