    item: {fileID: 11400000, guid: d09da36112c806944b932f54b2ada109, type: 2}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u0424\u0430\u043B\u044C\u0448\u0444\u0435\u0439\u0435\u0440: \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0433\u043E (Q), G. \u0412\u0441\u043F\u044B\u0448\u043A\u0430 \u043E\u0441\u043B\u0435\u043F\u043B\u044F\u0435\u0442 \u0432\u0441\u0435\u0445 \u0440\u044F\u0434\u043E\u043C, \u043E\u0433\u043E\u043D\u044C \u0434\u0435\u0440\u0436\u0438\u0442 \u041F\u0443\u0441\u0442\u044B\u0445 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438."
