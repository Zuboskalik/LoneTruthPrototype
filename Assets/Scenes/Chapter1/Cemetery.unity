  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: n1_hollow_seen
  steps:
  - type: 5
    speaker: 
    text: "\u041C\u0435\u0436\u0434\u0443 \u043C\u043E\u0433\u0438\u043B\u0430\u043C\u0438 \u043A\u0442\u043E-\u0442\u043E \u0438\u0434\u0451\u0442. \u0428\u0430\u0445\u0442\u0451\u0440. \u0413\u043B\u0430\u0437\u0430 \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F, \u043A\u0430\u043A \u043B\u0430\u043C\u043F\u044B."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0435\u0442\u0438\u0439? \u041D\u0435\u0442. \u041D\u0430 \u043D\u0451\u043C \u043A\u0430\u0441\u043A\u0430 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0433\u043E\u0434\u0430."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 14
    speaker: 
    text: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u041F\u0443\u0441\u0442\u043E\u0433\u043E \u043D\u0430 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u0414\u043E\u0441\u0442\u0430\u0442\u044C \u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440: \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0433\u043E (Q), G. \u041F\u0440\u0438\u0446\u0435\u043B: \u041F\u041A\u041C \u0438\u043B\u0438 Ctrl. \u0412\u044B\u0441\u0442\u0440\u0435\u043B: E. \u041F\u0435\u0440\u0435\u043A\u0430\u0442: Shift. \u0424\u0430\u043B\u044C\u0448\u0444\u0435\u0439\u0435\u0440: \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435, G."
