  - type: 5
    speaker: "\u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D"
    text: "\u0414\u044C\u044E\u043A \u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D, \u043E\u0445\u0440\u0430\u043D\u0430 \xAB\u0423\u0438\u0442\u043B\u043E\u043A \u041C\u0430\u0439\u043D\u0438\u043D\u0433\xBB. \u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u0432\u0430\u0441 \u0436\u0434\u0430\u043B\u0430. \u041D\u043E\u043C\u0435\u0440 \u0432 \u0441\u0430\u043B\u0443\u043D\u0435 \u043E\u043F\u043B\u0430\u0447\u0435\u043D."
