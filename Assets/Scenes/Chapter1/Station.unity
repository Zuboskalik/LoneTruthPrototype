  - type: 5
    speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A"
    text: "\u041C\u0438\u0441\u0442\u0435\u0440! \u0425\u043E\u043B\u043B\u043E\u0443-\u0420\u043E\u043A. \u0414\u0430\u043B\u044C\u0448\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u043D\u0435 \u043F\u043E\u0435\u0434\u0443 \u2014 \u043D\u0438 \u0437\u0430 \u043A\u0430\u043A\u0438\u0435 \u0434\u0435\u043D\u044C\u0433\u0438."
