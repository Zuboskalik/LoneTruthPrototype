  - type: 5
    speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A"
    text: "\u041D\u0438\u0447\u0435\u0433\u043E, \u043C\u0438\u0441\u0442\u0435\u0440. \u041F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0437\u0434\u0435\u0441\u044C \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
