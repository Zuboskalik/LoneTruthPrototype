  - type: 16
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: ReadLetter
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 0
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 2.2
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041F\u0438\u0441\u044C\u043C\u043E \u0431\u0435\u0437 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0433\u043E \u0430\u0434\u0440\u0435\u0441\u0430. \u041C\u0435\u0441\u044F\u0446 \u043D\u0430\u0437\u0430\u0434 \u0432 \u0448\u0430\u0445\u0442\u0435 \xAB\u0421\u0432\u044F\u0442\u0430\u044F \u0412\u0430\u0440\u0432\u0430\u0440\u0430\xBB \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u043E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0410 \u0432\u0434\u043E\u0432\u0430 \u043F\u0438\u0448\u0435\u0442, \u0447\u0442\u043E \u043C\u0443\u0436 \u0436\u0438\u0432. \u0418 \u0447\u0442\u043E \u043E\u043D \u043D\u0430\u0437\u0432\u0430\u043B \u043C\u043E\u0451 \u0438\u043C\u044F."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A"
    text: "\u041C\u0438\u0441\u0442\u0435\u0440! \u0425\u043E\u043B\u043B\u043E\u0443-\u0420\u043E\u043A. \u0414\u0430\u043B\u044C\u0448\u0435 \u0441\u0442\u0430\u043D\u0446\u0438\u0438 \u043D\u0435 \u043F\u043E\u0435\u0434\u0443 \u2014 \u043D\u0438 \u0437\u0430 \u043A\u0430\u043A\u0438\u0435 \u0434\u0435\u043D\u044C\u0433\u0438."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
