    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u0410 \u043C\u0438\u0441\u0442\u0435\u0440 \u0423\u0438\u0442\u043B\u043E\u043A?"
    actor: {fileID: 0}
    target: {fileID: 0}
