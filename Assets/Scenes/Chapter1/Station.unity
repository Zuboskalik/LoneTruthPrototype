  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u0427\u0442\u043E \u043D\u0435 \u0442\u0430\u043A \u0441 \u0425\u043E\u043B\u043B\u043E\u0443-\u0420\u043E\u043A\u043E\u043C?"
