    spawnId: 
    dialogue: {fileID: 0}
  - type: 16
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: ReadLetter
