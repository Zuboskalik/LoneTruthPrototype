  - type: 5
    speaker: "\u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D"
    text: "\u0425\u043E\u043B\u0442? \u0421\u044D\u043C\u044E\u044D\u043B \u0425\u043E\u043B\u0442 \u0438\u0437 \u0427\u0438\u043A\u0430\u0433\u043E?"
