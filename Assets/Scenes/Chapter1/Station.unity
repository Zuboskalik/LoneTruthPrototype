  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u0421\u043C\u043E\u0442\u0440\u044F \u043A\u0442\u043E \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442."
