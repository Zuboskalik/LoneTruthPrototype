  - type: 5
    speaker: 
    text: "\u0413\u0438\u043B\u044C\u0437\u0430. \u0421\u043E\u0440\u043E\u043A \u043F\u044F\u0442\u044B\u0439 \u043A\u0430\u043B\u0438\u0431\u0440, \u0441\u0432\u0435\u0436\u0430\u044F \u2014 \u0435\u0449\u0451 \u043D\u0435 \u043F\u043E\u0437\u0435\u043B\u0435\u043D\u0435\u043B\u0430. \u041A\u0442\u043E-\u0442\u043E \u0441\u0442\u0440\u0435\u043B\u044F\u043B \u043F\u0440\u044F\u043C\u043E \u0437\u0434\u0435\u0441\u044C, \u0443 \u043A\u043E\u043D\u0442\u043E\u0440\u044B."
