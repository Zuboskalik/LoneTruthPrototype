  - type: 15
    speaker: 
    text: "\u0423\u043B\u0438\u043A\u0430 \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435: \u0433\u0438\u043B\u044C\u0437\u0430 .45"
