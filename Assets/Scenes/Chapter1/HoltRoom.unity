  doneFlag: day1_morning
  steps:
  - type: 5
    speaker: 
    text: "\u041C\u0435\u0441\u044F\u0446 \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0451\u0439. \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u0410 \u043C\u0451\u0440\u0442\u0432\u044B\u0435, \u0432\u044B\u0445\u043E\u0434\u0438\u0442, \u043F\u0438\u0448\u0443\u0442 \u043F\u0438\u0441\u044C\u043C\u0430."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 2
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1.4
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 4
    speaker: 
    text: "\u0423\u0442\u0440\u043E.\n\u0414\u0435\u043D\u044C \u043F\u0435\u0440\u0432\u044B\u0439."
