  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: night1
  steps:
  - type: 5
    speaker: 
    text: "\u041D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0445\u0432\u0430\u0442\u0438\u0442. \u0414\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u2014 \u043F\u0430\u0440\u0430 \u0447\u0430\u0441\u043E\u0432 \u0441\u043D\u0430."
