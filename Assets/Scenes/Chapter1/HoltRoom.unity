    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1.4
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
