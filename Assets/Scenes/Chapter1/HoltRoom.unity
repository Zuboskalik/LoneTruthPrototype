  steps:
  - type: 5
    speaker: 
    text: "\u0415\u0441\u043B\u0438 \u043B\u044F\u0433\u0443 \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u0434\u0435\u043D\u044C \u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F. \u0410\u0433\u043D\u0435\u0441, \u0447\u0430\u0441\u043E\u0432\u043D\u044F, \u0441\u0430\u0440\u0430\u0439 \u0437\u0430 \u043A\u043E\u043D\u044E\u0448\u043D\u0435\u0439\u2026 \u0427\u0442\u043E \u043D\u0435 \u0443\u0441\u043F\u0435\u043B \u2014 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442 \u0434\u043E \u0437\u0430\u0432\u0442\u0440\u0430."
