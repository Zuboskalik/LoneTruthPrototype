    key: night1
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 4
    speaker: 
    text: "\u041D\u043E\u0447\u044C \u043F\u0435\u0440\u0432\u0430\u044F."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 2.5
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 0
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 0.3
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 3
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1.4
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041A\u043E\u043B\u043E\u043A\u043E\u043B. \u0411\u044C\u0451\u0442 \u043D\u0430 \u0432\u0435\u0441\u044C \u0433\u043E\u0440\u043E\u0434, \u0438 \u043E\u043A\u043D\u0430 \u0437\u0430 \u0441\u0442\u0435\u043A\u043B\u043E\u043C \u0433\u0430\u0441\u043D\u0443\u0442 \u043E\u0434\u043D\u043E \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041E\u0442 \u0447\u0430\u0441\u043E\u0432\u043D\u0438 \u043A\u0442\u043E-\u0442\u043E \u0438\u0434\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435. \u041F\u043E\u0440\u0430 \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 14
    speaker: 
    text: "\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u0432 \u0441\u0430\u043B\u0443\u043D. \u041F\u043E\u0442\u043E\u043C \u2014 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441\u043E\u0432\u043D\u044E \u043D\u0430 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435."
