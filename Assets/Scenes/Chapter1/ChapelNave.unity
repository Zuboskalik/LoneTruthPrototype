  - type: 5
    speaker: 
    text: "\u041E\u043F\u044F\u0442\u044C 4:17. \u041E\u043D \u0447\u0435\u0433\u043E-\u0442\u043E \u0431\u043E\u0438\u0442\u0441\u044F \u2014 \u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043D\u0435 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u0430."
