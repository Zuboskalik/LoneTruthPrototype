  steps:
  - type: 5
    speaker: 
    text: "\u0422\u0430\u0431\u043B\u0438\u0447\u043A\u0438 \u0441 \u0438\u043C\u0435\u043D\u0430\u043C\u0438 \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0445 \u0448\u0430\u0445\u0442\u0451\u0440\u043E\u0432. 1882 \u2014 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0438\u043C\u0451\u043D. 1906 \u2014 \u0441\u0435\u043C\u043D\u0430\u0434\u0446\u0430\u0442\u044C."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0418 \u043D\u043E\u0432\u0430\u044F, 1936-\u0433\u043E: \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0442\u0440\u0438. \u041A\u0440\u0430\u0441\u043A\u0430 \u0435\u0449\u0451 \u0441\u0432\u0435\u0436\u0430\u044F."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
