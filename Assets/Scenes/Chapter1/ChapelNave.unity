  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: q1_3_started
  steps:
  - type: 7
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 7.6
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u041C\u0438\u0440 \u0432\u0430\u043C, \u0441\u044B\u043D \u043C\u043E\u0439. \u0412\u044B \u0432\u0435\u0434\u044C \u0442\u043E\u0442 \u0441\u044B\u0449\u0438\u043A \u0438\u0437 \u0427\u0438\u043A\u0430\u0433\u043E?"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u0425\u043E\u043B\u0442"
    text: "\u0421\u044D\u043C \u0425\u043E\u043B\u0442. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0443 \u0432\u0430\u0441 \u043A\u043E\u043B\u043E\u043A\u043E\u043B \u0437\u0432\u043E\u043D\u0438\u0442 \u0441\u0430\u043C \u043F\u043E \u0441\u0435\u0431\u0435."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u041A\u0430\u0436\u0434\u0443\u044E \u043D\u043E\u0447\u044C. \u0412 4:17. \u0410 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u043D\u044F \u0437\u0430\u043F\u0435\u0440\u0442\u0430, \u0438 \u043A\u043B\u044E\u0447 \u0442\u043E\u043B\u044C\u043A\u043E \u0443 \u043C\u0435\u043D\u044F."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: "\u041E\u0442\u0435\u0446 \u041C\u044D\u0442\u044C\u044E"
    text: "\u0423\u0437\u043D\u0430\u0439\u0442\u0435, \u043A\u0442\u043E \u0437\u0432\u043E\u043D\u0438\u0442, \u043C\u0438\u0441\u0442\u0435\u0440 \u0425\u043E\u043B\u0442. \u041F\u0440\u043E\u0448\u0443 \u0432\u0430\u0441. \u0422\u043E\u043B\u044C\u043A\u043E\u2026 \u044D\u0442\u043E \u0441\u043B\u044B\u0448\u043D\u043E \u043B\u0438\u0448\u044C \u043D\u043E\u0447\u044C\u044E."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041E\u043F\u044F\u0442\u044C 4:17. \u041E\u043D \u0447\u0435\u0433\u043E-\u0442\u043E \u0431\u043E\u0438\u0442\u0441\u044F \u2014 \u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043D\u0435 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u0430."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u041D\u043E\u0432\u043E\u0435 \u0434\u0435\u043B\u043E \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435: \xAB\u041D\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u043B\u043E\u043A\u043E\u043B\xBB"
