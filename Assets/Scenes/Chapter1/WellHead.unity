--- !u!114 &210274460
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 210274457}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 96bfab2313a789342a4be8fd2f82531f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LoneTruth.Story.CutsceneSequence
  doneFlag: q1_1_knock
  steps:
  - type: 7
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 12.6
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0420\u0435\u0448\u0451\u0442\u043A\u0430 \u043F\u043E\u0434\u0430\u043B\u0430\u0441\u044C. \u0417\u0430 \u043D\u0435\u0439 \u043D\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u0435 \u043B\u0435\u0436\u0438\u0442 \u043F\u0438\u0441\u044C\u043C\u043E: \u0441\u0432\u0435\u0436\u0435\u0435, \u0441 \u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439 \u043F\u044B\u043B\u044C\u044E \u043D\u0430 \u0441\u0433\u0438\u0431\u0430\u0445."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 11
    speaker: 
    text: 
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: clue_fresh_letter
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 15
    speaker: 
    text: "\u0423\u043B\u0438\u043A\u0430 \u0432 \u0431\u043B\u043E\u043A\u043D\u043E\u0442\u0435: \u0441\u0432\u0435\u0436\u0435\u0435 \u043F\u0438\u0441\u044C\u043C\u043E \u0438\u0437 \u0441\u043A\u0432\u0430\u0436\u0438\u043D\u044B"
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 3.5
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u0421\u043D\u0438\u0437\u0443, \u0441 \u0433\u043B\u0443\u0431\u0438\u043D\u044B \u0434\u0432\u0435\u0441\u0442\u0438 \u043C\u0435\u0442\u0440\u043E\u0432, \u0438\u0434\u0451\u0442 \u0441\u0442\u0443\u043A. \u0422\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445. \u0422\u0440\u0438 \u0434\u043B\u0438\u043D\u043D\u044B\u0445."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 5
    speaker: 
    text: "\u041A\u0442\u043E-\u0442\u043E \u0436\u0438\u0432 \u0438 \u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u043E\u043C\u043E\u0449\u0438. \u041D\u043E \u0441\u043A\u0432\u0430\u0436\u0438\u043D\u0430 \u0443\u0437\u043A\u0430\u044F, \u0441\u0430\u043D\u0442\u0438\u043C\u0435\u0442\u0440\u043E\u0432 \u0441\u043E\u0440\u043E\u043A: \u043F\u0438\u0441\u044C\u043C\u043E \u043F\u0440\u043E\u0439\u0434\u0451\u0442, \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0435\u0442."
    actor: {fileID: 0}
    target: {fileID: 0}
    x: 0
    duration: 1
    speed: 1.6
    wait: 1
    boolValue: 1
    key: 
    item: {fileID: 0}
    amount: 1
    scene: 
    spawnId: 
    dialogue: {fileID: 0}
  - type: 14
    speaker: 
    text: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0410\u0433\u043D\u0435\u0441 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u043D\u0430\u0448\u043B\u043E\u0441\u044C \u0432 \u0441\u043A\u0432\u0430\u0436\u0438\u043D\u0435."
