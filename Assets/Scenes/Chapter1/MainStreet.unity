  - type: 5
    speaker: "\u041A\u044D\u043B\u043B\u0430\u0445\u0430\u043D"
    text: "\xAB\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043B\u0430\u043C\u043F\u0430\xBB. \u0425\u043E\u0437\u044F\u0439\u043A\u0443 \u0437\u043E\u0432\u0443\u0442 \u0420\u0443\u0444\u044C, \u043E\u043D\u0430 \u0432 \u043A\u0443\u0440\u0441\u0435."
